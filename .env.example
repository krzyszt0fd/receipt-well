# Copy to .env (gitignored) and fill in real values for receipt-well.http.
# Never commit .env — it holds tenant/client IDs and test-user credentials.

# Entra External ID (CIAM) tenant + app registration — same for local and develop,
# since both point at the same App Registrations. See Azure Portal > App registrations.
AUTHORITY=https://<tenant-subdomain-or-guid>.ciamlogin.com/<tenant-id>
CLIENT_ID=<SPA app registration client ID — must have "Allow public client flows" = Yes>
API_SCOPE=api://<API app registration client ID>/access_as_user

# Backend host per environment — toggle which @hostAddress line is active in receipt-well.http
LOCAL_HOST=https://localhost:7028
DEVELOP_HOST=https://<app-service-name>.azurewebsites.net

# Dedicated test user (local/email+password account in the CIAM tenant) — never a real user.
# ROPC cannot satisfy MFA/Conditional Access, so this account must have neither.
TEST_USERNAME=
TEST_PASSWORD=
