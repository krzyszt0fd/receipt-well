# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is listed in .gitignore and must never be committed.

# --- Required ---

# Your GitHub username or organization name.
# Used in the OIDC federated credential subject: repo:<github_org>/<github_repo>:ref:refs/heads/<branch>
github_org = "your-github-username-or-org"

# Azure OpenAI (Cognitive Services) account name. Also used as the custom
# subdomain — must be globally unique (*.openai.azure.com). No default in
# variables.tf — set here only.
openai_account_name = "your-globally-unique-openai-account-name"

# Azure OpenAI GPT-4o model deployment name. No default in variables.tf —
# set here only. "gpt-4o" is the conventional choice.
openai_deployment_name = "your-deployment-name"

# --- Optional overrides ---
# All defaults match the CLI runbook names in context/changes/deployment/deployment-plan.md.
# Uncomment and change only if you need non-default resource names.
# If you already ran Phase 1 CLI commands, keep these at their defaults and use
# terraform import to bring existing resources under Terraform management.

# location              = "westeurope"
# resource_group_name   = "receipt-well-rg"
# key_vault_name        = "receipt-well-kv"
# storage_account_name  = "receiptwellstorage"
# app_service_plan_name = "receipt-well-plan"
# web_app_name          = "receipt-well-api"
# static_web_app_name   = "receipt-well-web"
# oidc_app_registration_name = "receipt-well-github-deploy"
# github_repo           = "receipt-well"
# github_deploy_branch  = "develop"

# --- Search & storage (S-01) ---
# search_service_name     = "receipt-well-search"
# search_sku              = "free"   # change to "basic" if a Free tier service exists in the subscription
# search_index_name       = "receipts"
# staging_container_name  = "receipt-staging"
# receipts_container_name = "receipts"

# --- Azure OpenAI (S-03) ---
# openai_deployment_capacity = 8   # thousands of TPM, e.g. 8 = 8000 TPM

# --- Azure Functions extraction worker (S-03) ---
# function_service_plan_name = "receipt-well-functions-plan"
# function_app_name          = "receipt-well-functions"
# extraction_queue_name      = "receipt-extraction"
