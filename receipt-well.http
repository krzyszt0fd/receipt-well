@authority = {{$dotenv AUTHORITY}}
@clientId = {{$dotenv CLIENT_ID}}
@apiScope = {{$dotenv API_SCOPE}}

@hostAddress = {{$dotenv LOCAL_HOST}}
# @hostAddress = {{$dotenv DEVELOP_HOST}}

### Get an access token (ROPC — test users only, see .env.example). Run this request first.
# @name auth
POST {{authority}}/oauth2/v2.0/token
Content-Type: application/x-www-form-urlencoded

client_id={{clientId}}&scope={{apiScope}}&username={{$dotenv TEST_USERNAME}}&password={{$dotenv TEST_PASSWORD}}&grant_type=password

###

@token = {{auth.response.body.$.access_token}}

GET {{hostAddress}}/health

###
# @name stagingSlot
POST {{hostAddress}}/receipts/staging-slot
Authorization: Bearer {{token}}
Content-Type: application/json

###

@stagingUri = {{stagingSlot.response.body.$.stagingUri}}
@stagingBlobName = {{stagingSlot.response.body.$.stagingBlobName}}

###

PUT {{stagingUri}}
Content-Type: image/jpeg
x-ms-blob-type: BlockBlob
x-ms-blob-content-disposition: attachment; filename=example1.jpg

< ./examples/example1.jpg

###
# @name confirm
POST {{hostAddress}}/receipts/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "stagingBlobName": "{{stagingBlobName}}",
  "originalFileName": "example1.jpg"
}

###
@receiptId = {{confirm.response.body.$.receiptId}}

###

GET {{hostAddress}}/receipts
Authorization: Bearer {{token}}

###

# Tag search: Polish-stemmed full-text over tags (e.g. "rowery" matches a "rower" tag).
# Blank/missing q lists all; only the caller's receipts are ever returned.
GET {{hostAddress}}/receipts?q=rower
Authorization: Bearer {{token}}

###

PUT {{hostAddress}}/receipts/{{receiptId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fileName": "renamed-receipt.jpg"
}

###

DELETE {{hostAddress}}/receipts/{{receiptId}}
Authorization: Bearer {{token}}

###

GET {{hostAddress}}/receipts/{{receiptId}}/download-url
Authorization: Bearer {{token}}

###
