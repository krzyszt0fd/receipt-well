{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python .claude/check_cs_build.py",
            "timeout": 30,
            "statusMessage": "Checking compilation..."
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python .claude/check_csproj_restore.py",
            "timeout": 60,
            "statusMessage": "Rebuilding package lock file..."
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python .claude/check_frontend_lint.py",
            "timeout": 60,
            "statusMessage": "Linting frontend..."
          }
        ]
      }
    ]
  }
}
